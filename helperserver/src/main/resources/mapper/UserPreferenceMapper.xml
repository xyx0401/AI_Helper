<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.helperserver.mapper.UserPreferenceMapper">
    <resultMap id="BaseResultMap" type="com.helperserver.bean.UserPreference">
        <id column="preference_id" property="preferenceId" jdbcType="VARCHAR"/>
        <result column="user_id" property="userId" jdbcType="VARCHAR"/>
        <result column="interests" property="interests" jdbcType="VARCHAR"/>
        <result column="language" property="language" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        preference_id, user_id, interests, language
    </sql>

    <insert id="insert" parameterType="com.helperserver.bean.UserPreference">
        INSERT INTO user_preference (
        <include refid="Base_Column_List"/>
        )
        VALUES (
        #{preferenceId}, #{userId}, #{interests}, #{language}
        )
    </insert>

    <update id="update" parameterType="com.helperserver.bean.UserPreference">
        UPDATE user_preference
        SET interests = #{interests},
        language = #{language}
        WHERE user_id = #{userId}
    </update>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_preference
        WHERE user_id = #{userId}
    </select>

    <select id="findByInterest" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_preference
        WHERE interests LIKE CONCAT('%', #{interest}, '%')
    </select>

    <delete id="delete">
        DELETE FROM user_preference
        WHERE user_id = #{userId}
    </delete>
</mapper>