<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.helperserver.mapper.ResourceMapper">
    <resultMap id="ResourceMap" type="com.helperserver.bean.Resource">
        <id property="resourceId" column="resource_id"/>
        <result property="conferenceId" column="conference_id"/>
        <result property="agendaId" column="agenda_id"/>
        <result property="fileUrl" column="file_url"/>
        <result property="fileType" column="file_type"/>
    </resultMap>

    <insert id="insert" parameterType="com.helperserver.bean.Resource">
        INSERT INTO resource (
            resource_id,
            conference_id,
            agenda_id,
            file_url,
            file_type
        ) VALUES (
            #{resourceId},
            #{conferenceId},
            #{agendaId},
            #{fileUrl},
            #{fileType}
        )
    </insert>

    <select id="selectById" resultMap="ResourceMap">
        SELECT * FROM resource
        WHERE resource_id = #{resourceId}
    </select>

    <select id="selectByConferenceId" resultMap="ResourceMap">
        SELECT * FROM resource
        WHERE conference_id = #{conferenceId}
    </select>

    <select id="selectByAgendaId" resultMap="ResourceMap">
        SELECT * FROM resource
        WHERE agenda_id = #{agendaId}
    </select>

    <delete id="deleteById">
        DELETE FROM resource
        WHERE resource_id = #{resourceId}
    </delete>
</mapper>