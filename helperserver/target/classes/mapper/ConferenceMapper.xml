<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.helperserver.mapper.ConferenceMapper">
    <resultMap id="BaseResultMap" type="com.helperserver.bean.Conference">
        <id column="conference_id" property="conferenceId"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="tags" property="tags"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="location_id" property="locationId"/>
        <result column="speaker_id" property="speakerId"/>
    </resultMap>

    <sql id="Base_Column_List">
        conference_id, title, description, tags, start_time, end_time, location_id, speaker_id
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from conference
        where conference_id = #{conferenceId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from conference
        order by start_time asc
    </select>

    <select id="selectByTitle" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from conference
        where title like concat('%', #{title}, '%')
        order by start_time asc
    </select>
</mapper> 